@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var isSearch = controller == "Parser" && action == "SearchByMedia";
    var isHistory = controller == "Parser" && action == "MyResults";
    var isSources = controller == "Media";
}
<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#182820" />
    <title>@ViewData["Title"] — MediaParser</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#mainContent">Перейти до вмісту</a>
    <header class="app-header">
        <nav class="navbar navbar-expand-md navbar-light" aria-label="Основна навігація">
            <div class="container app-nav-container">
                <a class="navbar-brand" asp-controller="Parser" asp-action="SearchByMedia"><span class="brand-symbol" aria-hidden="true">m<span>p</span></span><span>MediaParser</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false" aria-label="Відкрити навігацію"><span class="navbar-toggler-icon"></span></button>
                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item"><a class="nav-link @(isSearch ? "active" : "")" aria-current="@(isSearch ? "page" : null)" asp-controller="Parser" asp-action="SearchByMedia">Пошук</a></li>
                        <li class="nav-item"><a class="nav-link @(isHistory ? "active" : "")" aria-current="@(isHistory ? "page" : null)" asp-controller="Parser" asp-action="MyResults">Історія</a></li>
                        <li class="nav-item"><a class="nav-link @(isSources ? "active" : "")" aria-current="@(isSources ? "page" : null)" asp-controller="Media" asp-action="EditMedia">Джерела</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <main id="mainContent" class="container app-main" tabindex="-1">@RenderBody()</main>
    <footer class="app-footer"><div class="container"><span>© @DateTime.Now.Year MediaParser</span><span class="footer-note">Перевірка відкритих джерел</span><a asp-controller="Home" asp-action="Privacy">Конфіденційність</a></div></footer>
    <div id="appNotifications" class="app-notifications" aria-live="polite" aria-atomic="false"></div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
