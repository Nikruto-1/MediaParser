@model MediaParser.Models.DBModels.MediaSource

@{
    ViewData["Title"] = "Додати нове медіа";
}

<h2>Додати нове медіа</h2>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" role="alert">
        @Html.ValidationSummary(false, "", new { @class = "text-danger" })
    </div>
}

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="Name">Назва</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="SearchUrl">Search URL</label>
        <input asp-for="SearchUrl" class="form-control" placeholder='приклад - https://github.com/{0}' />
        <span asp-validation-for="SearchUrl" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="ApiUrl">API URL (необов'язково)</label>
        <input asp-for="ApiUrl" class="form-control" placeholder="https://api.example.com/users/{0}" />
        <span asp-validation-for="ApiUrl" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="ApiKey">API ключ (необов'язково)</label>
        <input asp-for="ApiKey" type="password" class="form-control" autocomplete="new-password" />
    </div>
    <div class="form-group">
        <label asp-for="ErrorKeywordsRaw">Ключові слова помилок</label>
        <textarea asp-for="ErrorKeywordsRaw" class="form-control" placeholder='["error1", "error2"]'></textarea>
        <span asp-validation-for="ErrorKeywordsRaw" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Тип посилання</label>

        <div class="form-check">
            <input class="form-check-input" type="radio" asp-for="LinkType" id="LinkType_User" value="User">
            <label class="form-check-label" for="LinkType_User">Користувач</label>
        </div>

        <div class="form-check">
            <input class="form-check-input" type="radio" asp-for="LinkType" id="LinkType_FullName" value="FullName">
            <label class="form-check-label" for="LinkType_FullName">ПІБ</label>
        </div>
    </div>
    <span asp-validation-for="LinkType" class="text-danger"></span>


    <div class="form-group mt-2">
        <button type="submit" class="btn btn-primary">Зберегти</button>
    </div>
</form>
