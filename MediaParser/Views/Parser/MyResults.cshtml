@model List<ResultsModel>

@if (Model != null && Model.Count != 0)
{
    <div class="mb-4 text-center">
        <!-- Кнопка для экспорта в Excel -->
        <form asp-controller="Parser" asp-action="ExportExcel" method="post">
            <button type="submit" class="btn btn-success">
                📊 Завантажити в Excel
            </button>
        </form>
    </div>

    <div class="mt-4">
        <h3>Результати пошуку:</h3>

        @foreach (var result in Model)
        {
            <div class="mb-3">
                <h5 class="fw-bold">🔍 Нікнейм: @result.Nickname, час пошуку: @result.Date</h5>

                @if (result.Results.Any())
                {
                    <ul class="list-group">
                        @foreach (var dictionary in result.Results)
                        {
                            <li class="list-group-item d-flex flex-column justify-content-between align-items-start">
                                <div class="w-100 mb-2">
                                    <strong>@dictionary.Key</strong>
                                </div>
                                @if (!string.IsNullOrEmpty(dictionary.Value.ProfileUrl))
                                {
                                    <div class="w-100 mb-2">
                                        <a href="@dictionary.Value.ProfileUrl" target="_blank" rel="noopener noreferrer" class="text-decoration-none">
                                            @dictionary.Value.ProfileUrl
                                        </a>
                                    </div>
                                }
                                <span class="badge bg-@(dictionary.Value.Status.Contains("✅") ? "success" : dictionary.Value.Status.Contains("⚠️") ? "warning" : "danger")">
                                    @dictionary.Value.Status
                                </span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted">⚠️ Немає результатів для цього нікнейму.</p>
                }
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info text-center" role="alert">
        <strong>Ви поки що не шукали у медія</strong><br>
    </div>
}
