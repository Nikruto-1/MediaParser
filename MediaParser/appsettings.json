{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite"
  },
  "Captcha": {
    "Enabled": false,
    "MaxTasksPerSearch": 3,
    "TimeoutSeconds": 120,
    "PollIntervalSeconds": 5
  }
}
